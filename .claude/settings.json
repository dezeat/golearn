{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/block-edits-on-main.sh",
            "timeout": 10,
            "statusMessage": "Checking branch"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/format-on-edit.sh",
            "timeout": 30,
            "statusMessage": "Formatting edited file"
          }
        ]
      }
    ]
  }
}

    {
      "id": "provider-profile-contract",
      "capability": "provider-profiles",
      "fixture": "provider.json",
      "contract": "TestProviderFixtureCoversAllV1Profiles",
      "falsifier": "one V1 profile cannot satisfy the shared chat contract"
    },
    {
      "id": "verification-and-repair",
      "capability": "verification",
      "fixture": "generation.json",
      "contract": "TestGenerationFixtureCoversTheRichRequestAndTrustChain",
      "falsifier": "verification sees the proposed key or repair is spent more than once"
    },
    {
      "id": "bounded-repair",
      "capability": "repair",
      "fixture": "generation.json",
      "contract": "TestGenerationFixtureCoversTheRichRequestAndTrustChain",
      "falsifier": "a repaired candidate is not re-verified or consumes a second repair"
    },
    {
      "id": "shortfall-failure",
      "capability": "run-info",
      "fixture": "failure.json",
      "contract": "TestFailureFixtureFailsClearWithoutADraft",
      "falsifier": "a short pack is reported as success or raw provider output is persisted"
    },
    {
      "id": "near-duplicate-failure",
      "capability": "near-duplicate",
      "fixture": "near-duplicate.json",
      "contract": "TestNearDuplicateFixtureFailsClosed",
      "falsifier": "a candidate marked too similar reaches the draft"
    },
    {
      "id": "provenance-and-draft",
      "capability": "draft-lifecycle",
      "fixture": "review-flow.json",
      "contract": "TestReviewFixtureAcceptsThroughTheImportPort",
      "falsifier": "acceptance bypasses import or provenance is not carried into the pack"
    },
    {
      "id": "migration-isolation",
      "capability": "pack-compatibility",
      "fixture": "migration.json",
      "contract": "TestMigrationFixtureKeepsForgeAndCoreRegistriesSeparate",
      "falsifier": "Forge writes the core registry or changes a core table"
